# --- Dữ liệu ---
# Không commit dữ liệu thô (nặng, có thể vướng điều khoản phân phối lại)
data/raw/*
!data/raw/README.md
!data/raw/SOURCE.md
data/processed/*
!data/processed/README.md

# --- Trạng thái chạy ---
checkpoints/
logs/*
*.log
# Bằng chứng kiểm chứng của Task 5 — CỐ Ý commit để người chấm đối chiếu được
# (phải đặt SAU các dòng loại trừ ở trên, git lấy dòng khớp cuối cùng)
!logs/README.md
!logs/kafka_console_test.log
!logs/task5_*.log
!logs/task5_environment.txt
!logs/task6_*.log
!logs/task7_*.log

# --- Môi trường / bí mật ---
.venv/
venv/
__pycache__/
*.pyc
.env
*.key
*.pem

# --- Tài liệu mẫu của giảng viên (bản quyền Samsung, không phân phối lại) ---
templates/

# --- File tạm của Office ---
~$*
.tmp/

# --- Ghi chú ---
# outputs/ ĐƯỢC commit: mọi con số trong báo cáo phải truy vết được về file thật.
# Nhưng ảnh/CSV quá lớn thì cân nhắc Git LFS.

# --- File checksum .crc của Hadoop (sinh tự động khi lưu model ra đĩa cục bộ) ---
*.crc
